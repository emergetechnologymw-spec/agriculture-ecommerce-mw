
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Agriculture E-commerce</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f5f7f2;
  color: #243328;
}
header {
  background: #14532d;
  color: white;
  padding: 22px 16px;
  text-align: center;
}
header h1 { margin: 0; font-size: 25px; }
header p { margin-bottom: 0; }
nav {
  background: #fff;
  padding: 14px;
  text-align: center;
}
nav a {
  color: #14532d;
  text-decoration: none;
  margin: 8px;
  font-weight: bold;
}
.hero {
  padding: 35px 18px;
  text-align: center;
  background: #e2f0df;
}
.hero h2 { color: #14532d; }
.search {
  width: 90%;
  max-width: 500px;
  padding: 14px;
  border: 1px solid #bbb;
  border-radius: 8px;
  font-size: 16px;
}
button {
  background: #15803d;
  color: white;
  border: 0;
  padding: 12px 18px;
  border-radius: 7px;
  cursor: pointer;
}
main { padding: 20px; }
h2 { color: #14532d; }
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
  gap: 14px;
}
.card {
  background: white;
  padding: 20px 10px;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 2px 7px #00000012;
}
.card h3 { color: #166534; }
.info {
  background: white;
  margin-top: 22px;
  padding: 20px;
  border-radius: 10px;
}
footer {
  background: #14532d;
  color: white;
  padding: 22px;
  text-align: center;
  margin-top: 25px;
}
</style>
</head>
<body>

<header>
  <h1>AGRICULTURE E-COMMERCE</h1>
  <p>By Emerge Technology Company</p>
  <p>Connecting Farmers • Suppliers • Buyers</p>
</header>

<nav>
  <a href="#home">Home</a>
  <a href="#categories">Categories</a>
  <a href="#about">About</a>
</nav>

<section class="hero" id="home">
  <h2>Your Agricultural Marketplace</h2>
  <p>Discover agricultural products, connect with sellers and grow your business.</p>
  <input class="search" id="search" placeholder="Search agricultural products...">
  <p><button onclick="searchProducts()">Search Products</button></p>
</section>

<main>
  <section id="categories">
    <h2>Explore Categories</h2>
    <div class="grid" id="categoriesGrid">
      <div class="card"><h3>🌽</h3><strong>Crops & Grains</strong></div>
      <div class="card"><h3>🐄</h3><strong>Livestock</strong></div>
      <div class="card"><h3>🌱</h3><strong>Seeds</strong></div>
      <div class="card"><h3>🧪</h3><strong>Fertilizers</strong></div>
      <div class="card"><h3>🚜</h3><strong>Farm Equipment</strong></div>
      <div class="card"><h3>🥬</h3><strong>Fresh Produce</strong></div>
    </div>
  </section>

  <section class="info">
    <h2>For Farmers and Sellers</h2>
    <p>List your agricultural products and reach potential customers.</p>
    <button onclick="alert('Seller registration will be added in the next development stage.')">Become a Seller</button>
  </section>

  <section class="info">
    <h2>For Buyers</h2>
    <p>Discover products and connect with agricultural suppliers.</p>
    <button onclick="alert('Buyer registration will be added in the next development stage.')">Join as a Buyer</button>
  </section>

  <section class="info" id="about">
    <h2>Our Vision</h2>
    <p>To connect agricultural markets across Malawi, Africa and the world through digital commerce.</p>
  </section>
</main>

<footer>
  <p>Agriculture E-commerce</p>
  <p>Developed by Emerge Technology Company</p>
  <p>Knowledge. Intelligence. Action.</p>
</footer>

<script>
function searchProducts() {
  const query = document.getElementById('search').value.trim();
  if (query) {
    alert('Product search for: ' + query + '. Product listings will be connected in a future update.');
  } else {
    alert('Please enter a product name.');
  }
}
</script>

</body>
</html>
